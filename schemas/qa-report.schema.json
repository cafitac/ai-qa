{
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "preview-hub/v1"
    },
    "kind": {
      "const": "QaReport"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}(?![\\s\\S])"
    },
    "commits": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "SKIPPED"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "screenshot",
                    "log",
                    "http"
                  ]
                },
                "uri": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "uri"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "status",
          "summary",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "passed",
        "failed",
        "skipped"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "environment",
    "commits",
    "startedAt",
    "finishedAt",
    "scenarios",
    "summary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
