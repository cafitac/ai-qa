{
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "ai-qa/v1"
    },
    "hub": {
      "type": "object",
      "properties": {
        "dashboard_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/@\\\\]+(?:/[^\\s\\\\]*)?(?![\\s\\S])"
        },
        "access_team_domain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?![\\s\\S])"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*(?![\\s\\S])"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_scenarios": {
          "type": "integer",
          "minimum": 1
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "scenario_timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[smhd](?![\\s\\S])",
          "maxLength": 10
        },
        "protocol_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runs_dir": {
      "type": "string",
      "minLength": 1
    },
    "playwright_mcp": {
      "type": "string"
    }
  },
  "required": [
    "apiVersion"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
