{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {"const": "ai-qa/spec/v1"},
    "feature": {"type": "string", "minLength": 1, "maxLength": 200},
    "acs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^AC[0-9]{1,4}(?![\\s\\S])"},
          "scope": {"enum": ["in", "excluded"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "required": ["id", "scope", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["apiVersion", "feature", "acs"],
  "additionalProperties": false
}
