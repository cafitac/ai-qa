{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}(?![\\s\\S])"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 100}
  },
  "type": "object",
  "properties": {
    "apiVersion": {"const": "ai-qa/mutants/v1"},
    "project": {"$ref": "#/$defs/slug"},
    "baseline_ref": {"$ref": "#/$defs/ref"},
    "mutants": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "ref": {"$ref": "#/$defs/ref"},
          "service": {"$ref": "#/$defs/slug"},
          "category": {"$ref": "#/$defs/slug"},
          "axis": {"$ref": "#/$defs/slug"},
          "split": {"enum": ["DEV", "TEST"]},
          "scenarios": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}/[a-z][a-z0-9-]{1,40}(?![\\s\\S])"}},
          "check": {
            "type": "object",
            "properties": {
              "steps": {
                "type": "array", "minItems": 1, "maxItems": 10,
                "items": {
                  "type": "object",
                  "properties": {
                    "method": {"enum": ["GET", "POST"]},
                    "path": {"type": "string", "pattern": "^/[A-Za-z0-9/_.?=&-]{0,200}(?![\\s\\S])"},
                    "json": {},
                    "status": {"type": "integer", "minimum": 100, "maximum": 599},
                    "equals": {"type": "object", "maxProperties": 10}
                  },
                  "required": ["method", "path", "status"], "additionalProperties": false
                }
              }
            },
            "required": ["steps"], "additionalProperties": false
          }
        },
        "required": ["id", "ref", "service", "category", "axis", "split", "scenarios", "check"], "additionalProperties": false
      }
    }
  },
  "required": ["apiVersion", "project", "mutants"], "additionalProperties": false
}
